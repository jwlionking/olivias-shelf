# olivias-shelf.wyles.ai — TanStack Start (Nitro node-server)
# Public: Cloudflare Tunnel → edge .16 → this origin :80
# LAN:    curl -H "Host: olivias-shelf.wyles.ai" http://192.168.2.22/
# Upstream: PM2 olivias-shelf on 127.0.0.1:3046

map $http_upgrade $connection_upgrade_olivias_shelf {
    default upgrade;
    ""      close;
}

upstream olivias_shelf {
    server 127.0.0.1:3046;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name olivias-shelf.wyles.ai;

    client_max_body_size 20M;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Product "Olivias-Shelf" always;

    real_ip_header CF-Connecting-IP;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    set_real_ip_from 192.168.2.16;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;

    location / {
        proxy_pass http://olivias_shelf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_olivias_shelf;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    access_log /var/log/nginx/olivias-shelf.wyles.ai-access.log;
    error_log  /var/log/nginx/olivias-shelf.wyles.ai-error.log;
}
